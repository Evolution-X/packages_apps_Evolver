<resources>
    <style name="op_control_text_style_base">
        <item name="android:breakStrategy">simple</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="op_control_text_style_h6" parent="@style/op_control_text_style_base">
        <item name="android:textSize">18.0sp</item>
        <item name="android:fontFamily">@*android:string/config_headlineFontFamilyMedium</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="OptionTitleTextAppearance" parent="@style/TextAppearance.SettingsLib.LabelMedium">
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineHeight">15sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <!-- QS panel style thumbnails -->
    <style name="QsStylePreviewThumbItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="QsStylePreviewThumb">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">96dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="QsStylePreviewThumbTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textAppearance">?android:attr/textAppearanceSmall</item>
    </style>

    <!-- The pinned header around a PreviewStage -->
    <style name="PreviewStageHost">
        <item name="android:background">?android:attr/colorBackground</item>
        <item name="android:paddingStart">@dimen/preview_stage_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/preview_stage_padding_vertical</item>
        <item name="android:paddingEnd">@dimen/preview_stage_padding_horizontal</item>
        <item name="android:paddingBottom">@dimen/preview_stage_padding_vertical</item>
    </style>

    <!-- Plain TextView chips. A Material Chip needs the Material 3 theme attributes, which the
         Settings theme does not define, so the charging pages draw their own. -->
    <style name="ChargingChip">
        <item name="android:background">@drawable/charging_chip_background</item>
        <item name="android:textColor">@color/charging_chip_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingStart">@dimen/charging_chip_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/charging_chip_padding_horizontal</item>
    </style>

    <style name="ChargingChip.Stage">
        <item name="android:background">@drawable/charging_stage_chip_background</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

</resources>
