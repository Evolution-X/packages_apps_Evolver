<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/lock_glymps_title">

    <lineageos.preference.SystemSettingMainSwitchPreference
        android:key="lock_glymps_enabled"
        android:title="@string/action_enable"
        android:defaultValue="false" />

    <org.evolution.settings.preferences.WallpaperPreviewPreference
        android:key="lock_glymps_preview"
        android:selectable="false"
        android:dependency="lock_glymps_enabled"/>

    <PreferenceCategory
        android:title="@string/lock_glymps_source_category">

        <org.evolution.settings.preferences.SystemSettingListPreference
            android:key="lock_glymps_wallpaper_target"
            android:summary="%s"
            android:title="@string/lock_glymps_wallpaper_target_title"
            android:entries="@array/lock_glymps_wallpaper_target_entries"
            android:entryValues="@array/lock_glymps_wallpaper_target_values"
            android:defaultValue="0"
            android:dependency="lock_glymps_enabled" />

        <org.evolution.settings.preferences.SystemSettingListPreference
            android:key="lock_glymps_provider_lock"
            android:summary="%s"
            android:title="@string/lock_glymps_provider_lock_title"
            android:entries="@array/lock_glymps_provider_entries"
            android:entryValues="@array/lock_glymps_provider_values"
            android:defaultValue="picsum"
            android:dependency="lock_glymps_enabled" />

        <org.evolution.settings.preferences.SystemSettingListPreference
            android:key="lock_glymps_provider_home"
            android:summary="%s"
            android:title="@string/lock_glymps_provider_home_title"
            android:entries="@array/lock_glymps_provider_entries"
            android:entryValues="@array/lock_glymps_provider_values"
            android:defaultValue="picsum"
            android:dependency="lock_glymps_enabled" />

        <Preference
            android:key="lock_glymps_custom_urls"
            android:title="@string/lock_glymps_custom_urls_title"
            android:summary="@string/lock_glymps_custom_urls_summary"
            android:dependency="lock_glymps_enabled" />

        <Preference
            android:key="lock_glymps_folder_info"
            android:title="@string/lock_glymps_folder_title"
            android:summary="@string/lock_glymps_folder_summary"
            android:dependency="lock_glymps_enabled" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="lock_glymps_taste_category"
        android:title="@string/lock_glymps_taste_category"
        android:dependency="lock_glymps_enabled">

        <Preference
            android:key="lock_glymps_taste_lock_topics"
            android:title="@string/lock_glymps_taste_lock_topics_title"
            android:dependency="lock_glymps_enabled" />

        <ListPreference
            android:key="lock_glymps_taste_lock_categories"
            android:title="@string/lock_glymps_taste_lock_categories_title"
            android:summary="@string/lock_glymps_taste_lock_categories_summary"
            android:entries="@array/lock_glymps_wh_category_entries"
            android:entryValues="@array/lock_glymps_wh_category_values"
            android:defaultValue="110"
            android:dependency="lock_glymps_enabled" />

        <ListPreference
            android:key="lock_glymps_taste_lock_color"
            android:title="@string/lock_glymps_taste_lock_color_title"
            android:summary="@string/lock_glymps_taste_lock_color_summary"
            android:entries="@array/lock_glymps_wh_color_entries"
            android:entryValues="@array/lock_glymps_wh_color_values"
            android:defaultValue=""
            android:dependency="lock_glymps_enabled" />

        <ListPreference
            android:key="lock_glymps_taste_lock_preset"
            android:title="@string/lock_glymps_taste_lock_preset_title"
            android:summary="@string/lock_glymps_taste_lock_preset_summary"
            android:entries="@array/lock_glymps_commons_preset_entries"
            android:entryValues="@array/lock_glymps_commons_preset_values"
            android:defaultValue="quality"
            android:dependency="lock_glymps_enabled" />

        <Preference
            android:key="lock_glymps_taste_home_topics"
            android:title="@string/lock_glymps_taste_home_topics_title"
            android:dependency="lock_glymps_enabled" />

        <ListPreference
            android:key="lock_glymps_taste_home_categories"
            android:title="@string/lock_glymps_taste_home_categories_title"
            android:summary="@string/lock_glymps_taste_home_categories_summary"
            android:entries="@array/lock_glymps_wh_category_entries"
            android:entryValues="@array/lock_glymps_wh_category_values"
            android:defaultValue="110"
            android:dependency="lock_glymps_enabled" />

        <ListPreference
            android:key="lock_glymps_taste_home_color"
            android:title="@string/lock_glymps_taste_home_color_title"
            android:summary="@string/lock_glymps_taste_home_color_summary"
            android:entries="@array/lock_glymps_wh_color_entries"
            android:entryValues="@array/lock_glymps_wh_color_values"
            android:defaultValue=""
            android:dependency="lock_glymps_enabled" />

        <ListPreference
            android:key="lock_glymps_taste_home_preset"
            android:title="@string/lock_glymps_taste_home_preset_title"
            android:summary="@string/lock_glymps_taste_home_preset_summary"
            android:entries="@array/lock_glymps_commons_preset_entries"
            android:entryValues="@array/lock_glymps_commons_preset_values"
            android:defaultValue="quality"
            android:dependency="lock_glymps_enabled" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/lock_glymps_behavior_category"
        android:dependency="lock_glymps_enabled">

        <org.evolution.settings.preferences.SystemSettingListPreference
            android:key="lock_glymps_change_on"
            android:title="@string/lock_glymps_change_on_title"
            android:summary="@string/lock_glymps_change_on_summary"
            android:entries="@array/lock_glymps_change_on_entries"
            android:entryValues="@array/lock_glymps_change_on_values"
            android:defaultValue="1" />

        <org.evolution.settings.preferences.SystemSettingListPreference
            android:key="lock_glymps_timer_interval"
            android:title="@string/lock_glymps_timer_interval_title"
            android:summary="@string/lock_glymps_timer_interval_summary"
            android:entries="@array/lock_glymps_timer_entries"
            android:entryValues="@array/lock_glymps_timer_values"
            android:defaultValue="1800000"
            android:dependency="lock_glymps_enabled" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/lock_glymps_download_category"
        android:dependency="lock_glymps_enabled">

        <org.evolution.settings.preferences.SystemSettingSwitchPreference
            android:key="lock_glymps_wifi_only"
            android:title="@string/lock_glymps_wifi_only_title"
            android:summary="@string/lock_glymps_wifi_only_summary"
            android:defaultValue="true" />

        <org.evolution.settings.preferences.SystemSettingListPreference
            android:key="lock_glymps_cache_size"
            android:title="@string/lock_glymps_cache_size_title"
            android:summary="@string/lock_glymps_cache_size_summary"
            android:entries="@array/lock_glymps_cache_size_entries"
            android:entryValues="@array/lock_glymps_cache_size_values"
            android:defaultValue="5" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/lock_glymps_advanced_category"
        android:dependency="lock_glymps_enabled">

        <Preference
            android:key="lock_glymps_apply_now"
            android:title="@string/lock_glymps_apply_now"
            android:summary="@string/lock_glymps_apply_now_summary" />

        <Preference
            android:key="lock_glymps_clear_cache"
            android:title="@string/lock_glymps_clear_cache_title"
            android:summary="@string/lock_glymps_clear_cache_summary" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="lock_glymps_footer"
        android:title="@string/lock_glymps_footer_title">

        <Preference
            android:key="lock_glymps_current"
            android:title="@string/lock_glymps_current_title"
            android:summary="@string/lock_glymps_current_summary_empty"
            android:dependency="lock_glymps_enabled" />

        <Preference
            android:key="lock_glymps_footer_info"
            android:selectable="false"
            android:summary="@string/lock_glymps_footer_text" />

    </PreferenceCategory>

</PreferenceScreen>
