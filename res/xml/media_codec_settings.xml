    <Preference
        android:key="media_codec_summary"
        android:title="@string/media_codec_summary_title"
        android:selectable="false" />

    <PreferenceCategory
        android:key="media_codec_video_decoders"
        android:title="@string/media_codec_video_decoders" />

    <PreferenceCategory
        android:key="media_codec_video_encoders"
