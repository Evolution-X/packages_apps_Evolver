<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/spoof_screen_title">

    <PreferenceCategory
        android:key="pif_category"
        android:title="@string/pif_category_title">

        <Preference
            android:key="pif_fetch_beta"
            android:title="@string/pif_fetch_beta_title"
            android:summary="@string/pif_no_config_loaded" />

        <Preference
            android:key="pif_import_file"
            android:title="@string/pif_import_title"
            android:summary="@string/pif_import_summary" />

        <Preference
            android:key="pif_show_props"
            android:title="@string/pif_show_props_title"
            android:summary="@string/pif_no_props" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="pif_options_category"
        android:title="@string/pif_options_category">

        <!-- Pixel props -->
        <org.evolution.settings.preferences.SecureSettingSwitchPreference
            android:key="pi_pp_spoof"
            android:title="@string/spoofing_pixel_props_title"
            android:summary="@string/spoofing_pixel_props_summary"
            android:defaultValue="true" />

        <!-- Tensor features -->
        <org.evolution.settings.preferences.SecureSettingSwitchPreference
            android:key="pi_tensor_spoof"
            android:title="@string/tensor_spoof_title"
            android:summary="@string/tensor_spoof_summary"
            android:defaultValue="false" />

        <!-- App Spoofing -->
        <Preference
            android:key="user_selectable_app_spoofing"
            android:title="@string/user_selectable_app_spoofing_title"
            android:summary="@string/user_selectable_app_spoofing_summary"
            android:fragment="org.evolution.settings.fragments.miscellaneous.UserSelectedAppSpoofSettings" />

        <!-- Google Photos -->
        <SwitchPreferenceCompat
            android:key="pif_spoof_photos"
            android:title="@string/pif_spoof_photos_title"
            android:summary="@string/pif_spoof_photos_summary"
            android:defaultValue="false" />

        <!-- Snapchat -->
        <org.evolution.settings.preferences.SecureSettingSwitchPreference
            android:key="pi_snapchat_spoof"
            android:title="@string/spoofing_snap_title"
            android:summary="@string/spoofing_snap_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="cat_keybox"
        android:title="@string/keybox_category_title">

        <Preference
            android:key="keybox_import"
            android:title="@string/keybox_import_title"
            android:summary="@string/keybox_not_found" />

        <Preference
            android:key="keybox_delete"
            android:title="@string/keybox_delete_pref_title"
            android:summary="@string/keybox_delete_summary"
            android:enabled="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="cat_target"
        android:title="@string/target_category_title">

        <Preference
            android:key="target_manage_apps"
            android:title="@string/target_manage_title"
            android:summary="@string/target_no_apps" />

        <Preference
            android:key="target_import_file"
            android:title="@string/target_import_title"
            android:summary="@string/target_import_summary" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="cat_app_spoof"
        android:title="@string/app_spoof_category_title">

        <Preference
            android:key="app_spoof_manage"
            android:title="@string/app_spoof_manage_title"
            android:summary="@string/app_spoof_manage_summary" />

    </PreferenceCategory>

</PreferenceScreen>
