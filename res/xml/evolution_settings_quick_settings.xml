        <!-- QS Header -->
        <Preference
            android:key="qs_header_image"
            android:title="@string/quick_settings_header_image_title"
            android:summary="@string/quick_settings_header_image_summary"
            android:fragment="org.evolution.settings.fragments.quicksettings.QsHeaderImageSettings" />

        <!-- Single Tone QS -->
        <org.evolution.settings.preferences.SystemSettingSwitchPreference
            android:key="single_qs_tone_enabled"
            android:title="@string/qs_single_tone_title"
            android:summary="@string/qs_single_tone_summary"
            android:defaultValue="false" />

        <org.evolution.settings.preferences.SystemSettingSwitchPreference
            android:key="notification_bg_alternate_color"
            android:title="@string/notification_bg_alternate_color_title"
            android:summary="@string/notification_bg_alternate_color_summary"
            android:defaultValue="false" />

        <!-- QS Media Player  -->
        <org.evolution.settings.preferences.SecureSettingSwitchPreference
            android:key="qs_show_media_player"
            android:title="@string/qs_show_media_player_title"
            android:summary="@string/qs_show_media_player_summary"
            android:defaultValue="true" />

        <!-- Waveform seekbar -->
        <org.evolution.settings.preferences.SystemSettingSwitchPreference
            android:key="media_waveform_seekbar"
            android:title="@string/media_waveform_seekbar_title"
            android:summary="@string/media_waveform_seekbar_summary"
            android:defaultValue="false" />

        <!-- Squiggle animation for media notification -->
        <org.evolution.settings.preferences.SecureSettingSwitchPreference
            android:key="media_squiggle_animation"
            android:title="@string/media_squiggle_animation_title"
            android:summary="@string/media_squiggle_animation_summary"
            android:defaultValue="true" />

        <org.evolution.settings.preferences.SystemSettingSwitchPreference
            android:key="qs_compact_media_player_mode"
            android:title="@string/qs_compact_media_player_mode_title"
            android:summary="@string/qs_compact_media_player_mode_summary"
            android:defaultValue="false" />

