<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/qs_panel_style_title">

    <com.android.settingslib.widget.LayoutPreference
        android:key="qs_panel_style_thumbs"
        android:layout="@layout/qs_panel_style_thumbs"
        android:selectable="false"
        settings:searchable="false" />

    <org.evolution.settings.preferences.SystemSettingListPreference
        android:key="qs_panel_style"
        android:title="@string/qs_panel_style_title"
        android:entries="@array/qs_panel_style_entries"
        android:entryValues="@array/qs_panel_style_values"
        android:defaultValue="0" />

    <!-- The rows of the looks are added by QsPanelStyleSettings. -->
    <PreferenceCategory
        android:key="qs_remix_style"
        android:title="@string/qs_remix_style_title" />

    <org.evolution.settings.preferences.SystemSettingListPreference
        android:key="qs_tile_shape"
        android:title="@string/quick_settings_tile_shape_title"
        android:entries="@array/quick_settings_tile_shape_entries"
        android:entryValues="@array/quick_settings_tile_shape_values"
        android:defaultValue="0" />

    <org.evolution.settings.preferences.QSTileIconShapePreference
        android:key="qs_tile_icon_shape"
        android:title="@string/quick_settings_tile_shape_title" />

    <org.evolution.settings.preferences.SystemSettingSwitchPreference
        android:key="qs_tile_label_hide"
        android:title="@string/quick_settings_tile_label_hide_title"
        android:summary="@string/quick_settings_tile_label_hide_summary"
        android:defaultValue="false" />

    <org.evolution.settings.preferences.SystemSettingSwitchPreference
        android:key="qs_coloros_media_art_fill"
        android:title="@string/qs_coloros_media_art_fill_title"
        android:summary="@string/qs_coloros_media_art_fill_summary"
        android:defaultValue="false" />

    <org.evolution.settings.preferences.SystemSettingListPreference
        android:key="qs_nothing_color_style"
        android:title="@string/qs_nothing_color_style_title"
        android:entries="@array/qs_nothing_color_style_entries"
        android:entryValues="@array/qs_nothing_color_style_values"
        android:defaultValue="1" />

</PreferenceScreen>
