<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    style="@style/PreviewStageHost">

    <org.evolution.settings.utils.PreviewStage
        android:id="@+id/font_preview_stage"
        android:layout_width="match_parent"
        android:layout_height="@dimen/preview_stage_height_regular"
        android:background="@android:color/black"
        app:previewBackdrop="wallpaper">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="36dp"
            android:paddingEnd="24dp"
            android:importantForAccessibility="no">

            <TextClock
                android:id="@+id/font_preview_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:textColor="@android:color/white"
                android:textSize="44sp" />

            <TextView
                android:id="@+id/font_preview_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E6FFFFFF"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/font_preview_notification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/font_preview_notification_background"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/font_preview_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/font_preview_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="#E6FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/font_tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/preview_stage_gap"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/font_tab_fonts"
                style="@style/ChargingChip.Stage"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/charging_chip_height"
                android:text="@string/themes_fonts_category" />

            <TextView
                android:id="@+id/font_tab_emoji"
                style="@style/ChargingChip.Stage"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/charging_chip_height"
                android:layout_marginStart="@dimen/preview_stage_gap"
                android:text="@string/font_tab_emoji" />
        </LinearLayout>

        <TextView
            android:id="@+id/font_preview_apply"
            style="@style/ChargingChip.Stage"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/charging_chip_height"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/preview_stage_gap"
            android:text="@string/apply" />

    </org.evolution.settings.utils.PreviewStage>

    <HorizontalScrollView
        android:id="@+id/font_filter_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/preview_stage_gap"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/font_filter_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <HorizontalScrollView
        android:id="@+id/font_style_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/preview_stage_gap"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/font_style_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

</LinearLayout>
