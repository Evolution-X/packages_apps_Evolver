<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/settingslib_expressive_space_extrasmall1"
    android:minHeight="@dimen/settingslib_expressive_space_medium5"
    android:paddingVertical="@dimen/settingslib_expressive_space_extrasmall2"
    android:paddingStart="@dimen/settingslib_expressive_space_small3"
    android:paddingEnd="@dimen/settingslib_expressive_space_extrasmall4"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bg_picker_option">

    <TextView
        android:id="@+id/option_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingVertical="@dimen/settingslib_expressive_space_extrasmall4"
        android:textAppearance="@style/TextAppearance.SettingsLib.BodyLarge"
        android:textAlignment="viewStart"
        android:textColor="@color/picker_option_text" />

    <ImageButton
        android:id="@+id/option_play"
        android:layout_width="@dimen/settingslib_expressive_space_medium4"
        android:layout_height="@dimen/settingslib_expressive_space_medium4"
        android:layout_marginStart="@dimen/settingslib_expressive_space_extrasmall4"
        android:background="@drawable/bg_sound_play_button"
        android:padding="@dimen/settingslib_expressive_space_extrasmall6"
        android:scaleType="centerInside"
        android:src="@drawable/ic_sound_play"
        android:tint="@color/sound_play_icon" />
</LinearLayout>
