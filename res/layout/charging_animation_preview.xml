<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    style="@style/Widget.Evolver.PreviewStageHost">

    <org.evolution.settings.utils.PreviewStage
        android:layout_width="match_parent"
        android:layout_height="@dimen/preview_stage_height_regular"
        android:background="@android:color/black">

        <org.evolution.settings.fragments.lockscreen.ChargingPreviewView
            android:id="@+id/charging_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />

        <FrameLayout
            android:id="@+id/charging_plug_stage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="true"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <TextView
            android:id="@+id/charging_plug_hint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="@string/charging_plug_default_hint"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="#B3FFFFFF"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:theme="@style/ThemeOverlay.Evolver.Chip"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/preview_stage_gap"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/charging_mode_lock"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:checked="true"
                android:text="@string/charging_preview_mode_lock" />

            <com.google.android.material.chip.Chip
                android:id="@+id/charging_mode_plug"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/preview_stage_gap"
                android:checkable="true"
                android:text="@string/charging_preview_mode_plug" />
        </LinearLayout>

    </org.evolution.settings.utils.PreviewStage>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/preview_stage_gap"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/charging_style_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:theme="@style/ThemeOverlay.Evolver.Chip"
            app:chipSpacingHorizontal="8dp"
            app:singleLine="true"
            app:singleSelection="true"
            app:selectionRequired="true" />
    </HorizontalScrollView>

</LinearLayout>
