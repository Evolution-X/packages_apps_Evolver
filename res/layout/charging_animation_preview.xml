<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    android:paddingStart="@dimen/preview_stage_padding_horizontal"
    android:paddingTop="@dimen/preview_stage_padding_vertical"
    android:paddingEnd="@dimen/preview_stage_padding_horizontal"
    android:paddingBottom="@dimen/preview_stage_padding_vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        app:cardBackgroundColor="@android:color/black"
        app:cardCornerRadius="@dimen/preview_stage_corner_radius"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <org.evolution.settings.fragments.lockscreen.ChargingPreviewView
            android:id="@+id/charging_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />

        <FrameLayout
            android:id="@+id/charging_plug_stage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="true"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <TextView
            android:id="@+id/charging_plug_hint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="@string/charging_plug_default_hint"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="#B3FFFFFF"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:theme="@style/ThemeOverlay.Evolver.Chip"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/charging_mode_lock"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:checked="true"
                android:text="@string/charging_preview_mode_lock" />

            <com.google.android.material.chip.Chip
                android:id="@+id/charging_mode_plug"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:checkable="true"
                android:text="@string/charging_preview_mode_plug" />
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/charging_style_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:theme="@style/ThemeOverlay.Evolver.Chip"
            app:chipSpacingHorizontal="8dp"
            app:singleLine="true"
            app:singleSelection="true"
            app:selectionRequired="true" />
    </HorizontalScrollView>

</LinearLayout>
