<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    style="@style/PreviewStageHost">

    <org.evolution.settings.utils.PreviewStage
        android:layout_width="match_parent"
        android:layout_height="@dimen/preview_stage_height_regular"
        android:background="@android:color/black">

        <org.evolution.settings.utils.LockScreenPreviewLayer
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no">

            <org.evolution.settings.fragments.lockscreen.ChargingPreviewView
                android:id="@+id/charging_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />

        </org.evolution.settings.utils.LockScreenPreviewLayer>

        <FrameLayout
            android:id="@+id/charging_plug_stage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="true"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <TextView
            android:id="@+id/charging_plug_hint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="@string/charging_plug_default_hint"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="#B3FFFFFF"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/preview_stage_gap"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/charging_mode_lock"
                style="@style/ChargingChip.Stage"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/charging_chip_height"
                android:text="@string/charging_preview_mode_lock" />

            <TextView
                android:id="@+id/charging_mode_plug"
                style="@style/ChargingChip.Stage"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/charging_chip_height"
                android:layout_marginStart="@dimen/preview_stage_gap"
                android:text="@string/charging_preview_mode_plug" />
        </LinearLayout>

    </org.evolution.settings.utils.PreviewStage>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/preview_stage_gap"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/charging_style_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

</LinearLayout>
