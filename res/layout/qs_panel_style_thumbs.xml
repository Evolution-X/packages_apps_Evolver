<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="4dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            style="@style/QsStylePreviewThumbItem">

            <org.evolution.settings.fragments.quicksettings.QsStylePreviewView
                android:id="@+id/qs_style_thumb_card"
                style="@style/QsStylePreviewThumb" />

            <TextView
                android:id="@+id/qs_style_thumb_card_title"
                style="@style/QsStylePreviewThumbTitle"
                android:text="@string/qs_panel_style_card" />
        </LinearLayout>

        <LinearLayout
            style="@style/QsStylePreviewThumbItem">

            <org.evolution.settings.fragments.quicksettings.QsStylePreviewView
                android:id="@+id/qs_style_thumb_classic"
                style="@style/QsStylePreviewThumb" />

            <TextView
                android:id="@+id/qs_style_thumb_classic_title"
                style="@style/QsStylePreviewThumbTitle"
                android:text="@string/qs_panel_style_classic" />
        </LinearLayout>

        <LinearLayout
            style="@style/QsStylePreviewThumbItem">

            <org.evolution.settings.fragments.quicksettings.QsStylePreviewView
                android:id="@+id/qs_style_thumb_coloros"
                style="@style/QsStylePreviewThumb" />

            <TextView
                android:id="@+id/qs_style_thumb_coloros_title"
                style="@style/QsStylePreviewThumbTitle"
                android:text="@string/qs_panel_style_coloros" />
        </LinearLayout>

        <LinearLayout
            style="@style/QsStylePreviewThumbItem">

            <org.evolution.settings.fragments.quicksettings.QsStylePreviewView
                android:id="@+id/qs_style_thumb_nothingos"
                style="@style/QsStylePreviewThumb" />

            <TextView
                android:id="@+id/qs_style_thumb_nothingos_title"
                style="@style/QsStylePreviewThumbTitle"
                android:text="@string/qs_panel_style_nothingos" />
        </LinearLayout>

        <LinearLayout
            style="@style/QsStylePreviewThumbItem">

            <org.evolution.settings.fragments.quicksettings.QsStylePreviewView
                android:id="@+id/qs_style_thumb_remix"
                style="@style/QsStylePreviewThumb" />

            <TextView
                android:id="@+id/qs_style_thumb_remix_title"
                style="@style/QsStylePreviewThumbTitle"
                android:text="@string/qs_panel_style_remix" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
