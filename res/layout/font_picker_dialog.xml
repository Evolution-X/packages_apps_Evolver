<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/add_custom_font_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="8dp"
        android:minHeight="48dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_add_custom_font"
        android:drawableStart="@drawable/ic_menu_add_white"
        android:drawableTint="?android:attr/colorAccent"
        android:drawablePadding="8dp"
        android:text="@string/add_custom_font"
        android:textAppearance="@style/TextAppearance.SettingsLib.LabelLarge"
        android:textColor="?android:attr/colorAccent"
        android:textSize="15sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="4dp"
        android:paddingStart="2dp"
        android:paddingEnd="4dp" />
</LinearLayout>
