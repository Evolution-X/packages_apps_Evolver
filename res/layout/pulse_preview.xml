<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/PreviewStageHost">

    <org.evolution.settings.utils.PreviewStage
        android:layout_width="match_parent"
        android:layout_height="@dimen/preview_stage_height_compact"
        android:background="@android:color/black"
        app:previewBackdrop="wallpaper">

        <org.evolution.settings.fragments.lockscreen.PulsePreviewView
            android:id="@+id/pulse_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="12dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />

    </org.evolution.settings.utils.PreviewStage>

</FrameLayout>
